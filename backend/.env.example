PORT=8000

# MongoDB
MONGODB_URL=your_mongodb_connection_string

CORS_ORIGIN=*
NODE_ENV=development

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d

# NEW: base URL this backend is served from (used to build password-reset
# links and the reset-password page's API calls). Falls back to
# http://localhost:<PORT> in development if not set — only required in
# production/staging deployments.
BACKEND_URL=http://localhost:8000

# Frontend URL (used for CORS + links back to the app)
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer)
EMAIL_USER=your_email_address
EMAIL_PASS=your_email_app_password

# AssemblyAI (video -> transcript)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Groq (AI quiz generation + chatbot)
GROQ_API_KEY=your_groq_api_key

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# NEW: required for /api/v1/payments/webhook to work — without this,
# razorpayWebhook() always returns 500. Set this to the same secret you
# configure in the Razorpay Dashboard -> Webhooks -> Secret field.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
